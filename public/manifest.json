{
  "manifest_version": 3,
  "version": "0.7.6",
  "name": "metldr: AI browser assistant",
  "description": "Read pages, ask questions and automate browser tasks with your AI provider, local models or installed agents.",
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; connect-src 'self' http://localhost:11434 http://127.0.0.1:11434 https://media.githubusercontent.com https://raw.githubusercontent.com https://api.dictionaryapi.dev; style-src 'self' 'unsafe-inline'; font-src 'self';",
    "sandbox": "sandbox allow-scripts allow-forms allow-popups allow-modals; script-src 'self' 'unsafe-inline' 'unsafe-eval'; object-src 'self'; connect-src 'self';"
  },
  "sandbox": {
    "pages": [
      "sandbox.html"
    ]
  },
  "action": {
    "default_title": "Open metldr"
  },
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "64": "icon-64.png",
    "128": "icon-128.png"
  },
  "side_panel": {
    "default_path": "index.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>",
        "file://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "world": "ISOLATED"
    }
  ],
  "permissions": [
    "sidePanel",
    "storage",
    "scripting",
    "activeTab",
    "tabs",
    "offscreen",
    "nativeMessaging",
    "debugger",
    "webNavigation"
  ],
  "host_permissions": [
    "http://localhost:11434/*",
    "http://127.0.0.1:11434/*",
    "https://mail.google.com/*",
    "<all_urls>"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "pageWorld.js",
        "assets/*.js",
        "assets/*.css",
        "assets/*.wasm",
        "assets/logo/*",
        "welcome.html",
        "sandbox.html",
        "gpu-bridge.js",
        "models/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "minimum_chrome_version": "125",
  "commands": {
    "open-browser-agent": {
      "suggested_key": {
        "default": "Alt+Shift+M"
      },
      "description": "Open browser agent"
    },
    "open-page-tools": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y"
      },
      "description": "Open page tools"
    }
  }
}
